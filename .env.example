# PostgreSQL — Railway подставит DATABASE_URL автоматически
DATABASE_URL=postgresql://user:pass@host:5432/fleetdesk

# Токен единого Telegram-бота (один на все компании).
# Получить у @BotFather → /newbot. Настраивается один раз здесь,
# в CRM токен больше не вводится.
BOT_TOKEN=123456:ABCDEFghijklmnopqrstuvwxyz

# Токен бота в мессенджере MAX. Получить: напишите @MasterBot команду
# /create, задайте имя (окончание _bot) — он выдаст токен.
# Если переменная не задана, MAX-бот просто не запускается.
MAX_BOT_TOKEN=

# Ник бота в MAX. Обычно сервер узнаёт его сам, но если API MAX
# недоступен из сети хостинга — ссылка в CRM возьмётся отсюда.
MAX_BOT_USERNAME=

# Секрет для API между CRM и ботом
NOTIFY_SECRET=your_secret_here

# Порт для Express HTTP API (по умолчанию 3001)
NOTIFY_PORT=3001

# Адрес CRM — из него бот собирает ссылку на кабинет водителя
CRM_BASE_URL=https://www.grubov.com

# Первый администратор сервиса. Создаётся один раз при первом старте,
# если в базе ещё нет ни одного админа. После создания переменные
# можно удалить — учётная запись останется в базе.
ADMIN_EMAIL=admin@grubov.com
ADMIN_PASSWORD=придумайте_надёжный_пароль
ADMIN_NAME=Геннадий

# Домены, которым разрешён доступ к API (через запятую).
# По умолчанию: grubov.com, www.grubov.com и railway-домен CRM
# ALLOWED_ORIGINS=https://www.grubov.com,https://grubov.com
